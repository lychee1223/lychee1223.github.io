{
  "name": "research-website-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write --ignore-unknown",
    "news:add": "node scripts/add-news-entry.mjs",
    "format:check": "prettier . --check --ignore-unknown",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "links:check": "node scripts/check-links.mjs internal",
    "links:external": "node scripts/check-links.mjs external",
    "test:links": "node --test tests/link-checker.integration.mjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "lucide-react": "^0.469.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "overrides": {
    "katex": "$katex",
    "postcss-selector-parser": "^7.1.7"
  }
}
